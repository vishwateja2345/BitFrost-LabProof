{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence workspace run envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "run_id", "mode", "status", "created_at", "artifacts", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"enum": ["labproof"]},
    "run_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,100}$"},
    "mode": {"enum": ["replay", "local", "live"]},
    "status": {"enum": ["completed", "incomplete", "blocked", "failed", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?:[A-Za-z0-9_.-]*[A-Za-z0-9_-]/)*[A-Za-z0-9_.-]*[A-Za-z0-9_-]$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
